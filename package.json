{
  "name": "faso-zik",
  "version": "1.0.0",
  "private": true,
  "description": "FASO-ZIK — plateforme de streaming musical et video pour les artistes du Faso : streaming MP3/video, telechargement sous autorisation de l'artiste, espace artiste et platine DJ.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs scripts/seed.mjs",
    "check": "node scripts/check-icons.mjs",
    "verifier": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs scripts/verifier-installation.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs --test tests/*.test.js",
    "admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs scripts/promouvoir-admin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@breezystack/lamejs": "^1.2.7",
    "@electric-sql/pglite": "^0.5.5",
    "@reduxjs/toolkit": "^2.2.7",
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^2.4.3",
    "next": "^14.2.15",
    "next-auth": "^4.24.7",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.3.0",
    "react-redux": "^9.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13"
  }
}
