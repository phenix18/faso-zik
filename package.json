{
  "name": "faso-zik",
  "version": "1.0.0",
  "private": true,
  "description": "FASO-ZIK — plateforme de streaming musical et video pour les artistes du Faso : streaming MP3/video, telechargement sous autorisation de l'artiste, espace artiste et platine DJ.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/clean-standalone.mjs",
    "start": "next start",
    "lint": "next lint",
    "seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/reset.mjs",
    "check": "node scripts/check-icons.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test tests/*.test.js",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "music-metadata": "^7.14.0",
    "next": "^14.2.15",
    "next-auth": "^4.24.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.3.0",
    "react-redux": "^9.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13"
  }
}
