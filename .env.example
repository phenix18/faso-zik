# --- Authentification -------------------------------------------------------
# Cle de signature des sessions. Generer avec : openssl rand -base64 32
NEXTAUTH_SECRET=changez-cette-valeur-en-production
NEXTAUTH_URL=http://localhost:3000

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stockage ---------------------------------------------------------------
# Emplacement des fichiers audio/video/images (volume persistant en production)
MEDIA_ROOT=./storage/media
# Fichier SQLite
DATABASE_FILE=./data/faso-zik.db

# --- Contacts affiches sur la page /droits ----------------------------------
NEXT_PUBLIC_CONTACT_RIGHTS=droits@faso-zik.bf
NEXT_PUBLIC_CONTACT_GENERAL=contact@faso-zik.bf

# --- Transcodage ------------------------------------------------------------
# ffmpeg fabrique les versions allegees (MP3 pour l'ecoute, HLS pour les clips).
# Laissez vide si les binaires sont dans le PATH ; sans eux, les fichiers
# d'origine sont servis tels quels.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# --- Paiement mobile money --------------------------------------------------
# "simulation" (defaut) rejoue le cycle d'un paiement sans appeler d'operateur :
# c'est le mode du developpement. "agregateur" parle a un agregateur reel.
PAIEMENT_FOURNISSEUR=simulation

# Requis avec "agregateur" seulement. Verifiez la documentation en vigueur de
# votre prestataire : les noms de champs et la signature varient.
# PAIEMENT_API_URL=https://api.mon-agregateur.example
# PAIEMENT_API_CLE=
# PAIEMENT_API_SECRET=

# Part retenue par la plateforme sur les ventes et les soutiens, en pourcentage.
COMMISSION_POURCENT=10

# --- Limites de depot -------------------------------------------------------
MAX_AUDIO_MB=40
MAX_VIDEO_MB=400
MAX_IMAGE_MB=8
