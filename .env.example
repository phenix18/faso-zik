# --- Authentification -------------------------------------------------------
# Cle de signature des sessions. Generer avec : openssl rand -base64 32
NEXTAUTH_SECRET=changez-cette-valeur-en-production
NEXTAUTH_URL=http://localhost:3000

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stockage ---------------------------------------------------------------
# Emplacement des fichiers audio/video/images (volume persistant en production)
MEDIA_ROOT=./storage/media
# Fichier SQLite
DATABASE_FILE=./data/faso-zik.db

# --- Limites de depot -------------------------------------------------------
MAX_AUDIO_MB=40
MAX_VIDEO_MB=400
MAX_IMAGE_MB=8
