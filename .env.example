# --- Base de donnees --------------------------------------------------------
# Chaine de connexion PostgreSQL. Sur Supabase, prendre l'adresse du pooler en
# mode transaction (port 6543) : une plateforme sans serveur ouvre beaucoup de
# connexions courtes, qu'un acces direct saturerait.
DATABASE_URL=postgresql://postgres.projet:motdepasse@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Laisser vide en developpement : un PostgreSQL en memoire (PGlite) prend le
# relais, sans service exterieur a lancer.

# --- Stockage des medias ----------------------------------------------------
# Deux fournisseurs possibles. Renseigner les variables de l'un ou de l'autre
# suffit a le choisir ; STOCKAGE_FOURNISSEUR ne tranche que si les deux sont la.
# STOCKAGE_FOURNISSEUR=supabase   # ou "s3"

# Supabase Storage
SUPABASE_URL=https://votre-projet.supabase.co
# Cle de service : elle ne quitte jamais le serveur.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=faso-zik

# Compatible S3 : Cloudflare R2, Backblaze B2, MinIO, S3. R2 ne facture pas le
# trafic sortant, qui est le poste le plus lourd d'un site de musique.
# Le seau doit autoriser les envois PUT depuis le domaine du site (regle CORS),
# les artistes deposant directement au stockage.
# S3_ENDPOINT=https://<identifiant-de-compte>.r2.cloudflarestorage.com
# S3_BUCKET=faso-zik
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# Duree de validite des adresses signees, en secondes.
MEDIA_URL_DUREE=300
MEDIA_DEPOT_DUREE=900

# --- Authentification -------------------------------------------------------
# Generer avec : openssl rand -base64 32
NEXTAUTH_SECRET=changez-cette-valeur-en-production
NEXTAUTH_URL=https://votre-domaine.example

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://votre-domaine.example
NEXT_PUBLIC_CONTACT_RIGHTS=droits@votre-domaine.example
NEXT_PUBLIC_CONTACT_GENERAL=contact@votre-domaine.example

# --- Courriel ---------------------------------------------------------------
# Sert au lien de reinitialisation de mot de passe. Sans SMTP renseigne, la
# page l'annonce clairement plutot que de laisser attendre un message qui
# n'arrivera jamais.
# SMTP_HOTE=
# SMTP_PORT=587
# SMTP_UTILISATEUR=
# SMTP_MOT_DE_PASSE=
# SMTP_EXPEDITEUR=faso-zik@votre-domaine.example
RESET_DUREE_MINUTES=60

# --- Paiement mobile money --------------------------------------------------
# "simulation" rejoue le cycle d'un paiement sans appeler d'operateur : c'est
# le mode du developpement. "agregateur" parle a un agregateur reel.
PAIEMENT_FOURNISSEUR=simulation

# La simulation est refusee en production : elle laisse l'acheteur declarer
# lui-meme son paiement recu. Ne mettre "oui" que sur un site de demonstration
# assume, jamais sur un site qui vend reellement.
# PAIEMENT_SIMULATION_AUTORISEE=non

# Requis avec "agregateur" seulement.
# PAIEMENT_API_URL=
# PAIEMENT_API_CLE=
# PAIEMENT_API_SECRET=

# Part retenue par la plateforme, en pourcentage.
COMMISSION_POURCENT=10

# --- Limites de depot -------------------------------------------------------
MAX_AUDIO_MB=40
MAX_VIDEO_MB=400
MAX_IMAGE_MB=8
